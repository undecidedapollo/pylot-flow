{
  "name": "@pylot/flow",
  "type": "commonjs",
  "version": "1.0.0-rc3",
  "description": "A collection of tools for creating lazy sequences.",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
  "readme": "README.md",
  "scripts": {
    "build": "rm -dr dist; npm run lint; npm run tsc; npm run test; ",
    "lint": "eslint --ext ts src/**",
    "lint:fix": "eslint --fix --ext ts src/**",
    "test": "jest ",
    "tsc": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/pylot-node/packages/flow.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "keywords": [
    "pylot",
    "flow",
    "generator",
    "lazy",
    "iterator",
    "functional"
  ],
  "author": "Jonah Nestrick<undecidedapollo>",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/eslint-plugin": "^8.31.1",
    "@typescript-eslint/parser": "^8.31.1",
    "eslint": "9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^29.7.0",
    "lodash.iserror": "^3.1.1",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "test",
    "testRegex": ".*\\.test\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
