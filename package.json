{
  "name": "@pylot/flow",
  "type": "module",
  "version": "1.0.0-rc4",
  "description": "A collection of tools for creating lazy sequences.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "imports": {
    "#*.js": {
      "source": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "readme": "README.md",
  "scripts": {
    "build": "npm run clean && npm run lint && npm run tsc -- -p tsconfig.build.json && npm run test",
    "clean": "rm -rf dist *.tsbuildinfo",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint --fix \"src/**/*.ts\"",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/.bin/jest",
    "tsc": "tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/undecidedapollo/pylot-flow.git"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "keywords": [
    "pylot",
    "flow",
    "generator",
    "lazy",
    "iterator",
    "functional"
  ],
  "author": "Jonah Nestrick<undecidedapollo>",
  "license": "ISC",
  "devDependencies": {
    "@jest/globals": "^30.3.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-prettier": "^5.2.6",
    "jest": "^30.3.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.4.9",
    "typescript": "^6.0.3"
  },
  "jest": {
    "preset": "ts-jest/presets/default-esm",
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "test",
    "testRegex": ".*\\.test\\.ts$",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^#(.+)\\.js$": "<rootDir>/../src/$1"
    },
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
